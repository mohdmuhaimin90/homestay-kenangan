---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Above-the-fold image to preload (absolute path). Emits <link rel="preload"> in <head>. */
  preloadImage?: string;
}

const {
  title,
  description,
  canonical = 'https://homestay-kenangan.vercel.app/',
  ogImage = '/images/kuala-terengganu/exterior.jpg',
  ogType = 'website',
  noindex = false,
  preloadImage,
} = Astro.props;

const siteName = 'Homestay Kenangan';
const currentUrl = canonical;
const siteOrigin = new URL(canonical).origin;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteOrigin}${ogImage}`;

// Google Search Console verification token. Set PUBLIC_GSC_VERIFICATION in Vercel
// env to emit <meta name="google-site-verification">. Empty = tag omitted.
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  '@id': `${siteOrigin}/#business`,
  name: 'Homestay Kenangan',
  description:
    'Clean, comfortable and affordable family homestay with two locations in Kemaman and Kuala Terengganu, Terengganu, Malaysia.',
  url: siteOrigin,
  telephone: '+60199144505',
  email: 'kenangan.homestay@gmail.com',
  image: `${siteOrigin}/images/kuala-terengganu/exterior.jpg`,
  logo: `${siteOrigin}/images/logo.png`,
  priceRange: 'RM',
  currenciesAccepted: 'MYR',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kemaman & Kuala Terengganu',
    addressRegion: 'Terengganu',
    addressCountry: 'MY',
  },
  amenityFeature: [
    'Free Parking',
    'Air Conditioning',
    'Full Kitchen',
    'High-speed WiFi',
    'Smart TV',
  ].map((n) => ({ '@type': 'LocationFeatureSpecification', name: n, value: true })),
  numberOfRooms: 7,
  sameAs: ['https://maps.app.goo.gl/KyBmg1iwgqLiSsha9', 'https://maps.app.goo.gl/SCBDByiRjyYQefny6'],
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow" />}
    <meta name="theme-color" content="#800020" />
    <meta name="color-scheme" content="light" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Above-the-fold image (LCP) — start the request before CSS/JS parse -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_MY" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Sitemap discovery -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Fonts (self-hosted, no render-blocking third-party request) -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/S6uyw4BMUTPHjx4wXg.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <title>{title} | {siteName}</title>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
