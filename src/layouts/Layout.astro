---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Above-the-fold image to preload (absolute path). Emits <link rel="preload"> in <head>. */
  preloadImage?: string;
}

const {
  title,
  description,
  canonical = 'https://homestay-kenangan.vercel.app/',
  ogImage = '/images/kuala-terengganu/exterior.jpg',
  ogType = 'website',
  noindex = false,
  preloadImage,
} = Astro.props;

const siteName = 'Homestay Kenangan';
const currentUrl = canonical;
const siteOrigin = new URL(canonical).origin;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteOrigin}${ogImage}`;

// Google Search Console verification token. Set PUBLIC_GSC_VERIFICATION in Vercel
// env to emit <meta name="google-site-verification">. Empty = tag omitted.
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  '@id': `${siteOrigin}/#business`,
  name: 'Homestay Kenangan',
  description:
    'Clean, comfortable and affordable family homestay with two locations in Kemaman and Kuala Terengganu, Terengganu, Malaysia.',
  url: siteOrigin,
  telephone: '+60199144505',
  email: 'kenangan.homestay@gmail.com',
  image: `${siteOrigin}/images/kuala-terengganu/exterior.jpg`,
  logo: `${siteOrigin}/images/logo.png`,
  priceRange: 'RM',
  currenciesAccepted: 'MYR',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kemaman & Kuala Terengganu',
    addressRegion: 'Terengganu',
    addressCountry: 'MY',
  },
  amenityFeature: [
    'Free Parking',
    'Air Conditioning',
    'Full Kitchen',
    'High-speed WiFi',
    'Smart TV',
  ].map((n) => ({ '@type': 'LocationFeatureSpecification', name: n, value: true })),
  numberOfRooms: 7,
  sameAs: ['https://maps.app.goo.gl/KyBmg1iwgqLiSsha9', 'https://maps.app.goo.gl/SCBDByiRjyYQefny6'],
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow" />}
    <meta name="theme-color" content="#800020" />
    <meta name="color-scheme" content="light" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Above-the-fold image (LCP) — start the request before CSS/JS parse -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_MY" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Sitemap discovery -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Fonts (self-hosted, no render-blocking third-party request) -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/S6uyw4BMUTPHjx4wXg.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <title>{title} | {siteName}</title>
  </head>
  <body class="antialiased">
    <slot />
    <script is:inline>
  (() => {
    document.querySelectorAll('[data-slider-id]').forEach((sliderEl) => {
      const sliderId = sliderEl.dataset.sliderId;
      const location = sliderEl.dataset.location;
      const images = JSON.parse(sliderEl.dataset.images || '[]');

      const track = sliderEl.querySelector('[data-slider-track]');
      const prevBtn = sliderEl.querySelector('[data-slider-prev]');
      const nextBtn = sliderEl.querySelector('[data-slider-next]');

      const lightboxId = sliderEl.dataset.lightboxId;
      const lightbox = document.getElementById(lightboxId);
      const lbSource = lightbox.querySelector('[data-lightbox-source]');
      const lbImage = lightbox.querySelector('[data-lightbox-image]');
      const lbCaption = lightbox.querySelector('[data-lightbox-caption]');
      const lbCounter = lightbox.querySelector('[data-lightbox-counter]');
      const lbPrev = lightbox.querySelector('[data-lightbox-prev]');
      const lbNext = lightbox.querySelector('[data-lightbox-next]');
      const lbClose = lightbox.querySelector('[data-lightbox-close]');

      const slides = Array.from(track.querySelectorAll('[data-open-lightbox]'));
      let current = 0;

      const toWebp = (src) => src.replace(/\.(jpe?g|png)$/i, '.webp');  // 1024w full variant

      function scrollByCard(dir) {
        const item = track.querySelector('[data-open-lightbox]');
        const width = item ? item.getBoundingClientRect().width + 16 : 420;
        track.scrollBy({ left: dir * width, behavior: 'smooth' });
      }

      prevBtn.addEventListener('click', () => scrollByCard(-1));
      nextBtn.addEventListener('click', () => scrollByCard(1));

      function renderSlide() {
        if (!lbImage || !images[current]) return;
        if (lbSource) lbSource.srcset = toWebp(images[current].src);
        lbImage.src = images[current].src;
        lbImage.alt = images[current].alt;
        if (lbCaption) lbCaption.textContent = images[current].alt;
        if (lbCounter) lbCounter.textContent = (current + 1) + ' / ' + images.length;
      }

      function openLightbox(index) {
        current = index;
        renderSlide();
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }

      slides.forEach((slide, i) => {
        slide.addEventListener('click', () => {
          const idx = parseInt(slide.getAttribute('data-open-lightbox'), 10) || i;
          openLightbox(idx);
        });
      });

      lbClose.addEventListener('click', closeLightbox);

      function go(delta) {
        current = (current + delta + images.length) % images.length;
        renderSlide();
      }

      lbPrev.addEventListener('click', (e) => { e.stopPropagation(); go(-1); });
      lbNext.addEventListener('click', (e) => { e.stopPropagation(); go(1); });

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') go(-1);
        if (e.key === 'ArrowRight') go(1);
      });

      let touchStartX = 0;
      let touchStartY = 0;
      lbImage.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }, { passive: true });
      lbImage.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) go(1);
          else go(-1);
        }
      }, { passive: true });
    });
  })();
</script>
  </body>
</html>
