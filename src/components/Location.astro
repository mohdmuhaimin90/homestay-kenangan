---
const homestays = [
  {
    name: 'Homestay Kenangan Kemaman',
    address: 'Kemaman, Terengganu, Malaysia',
    mapUrl: 'https://maps.app.goo.gl/KyBmg1iwgqLiSsha9',
    coords: '4.1877663,103.4180616',
    nearbyPlaces: [
      { name: 'Masjid Berenjut', time: '3 min', emoji: '🕌' },
      { name: 'KPTM', time: '5 min', emoji: '🎓' },
      { name: 'Pantai Teluk Mak Nik', time: '10 min', emoji: '🏖️' },
      { name: 'Pantai Chendor', time: '10 min', emoji: '🏖️' },
      { name: 'Cherating', time: '15 min', emoji: '🏄' },
      { name: 'Bandar Chukai', time: '15 min', emoji: '🏙️' },
      { name: 'Pasaraya Terdekat', time: '5 min', emoji: '🛒' },
    ],
  },
  {
    name: 'Homestay Kenangan Kuala Terengganu',
    address: 'Kuala Terengganu, Terengganu, Malaysia',
    mapUrl: 'https://maps.app.goo.gl/SCBDByiRjyYQefny6',
    coords: '5.3656086,103.0910559',
    nearbyPlaces: [
      { name: 'UMT', time: '6 km', emoji: '🎓' },
      { name: 'Unisza', time: '5 km', emoji: '🎓' },
      { name: 'Mydin Mall', time: '1.5 km', emoji: '🛒' },
      { name: 'Drawbridge', time: '9 km', emoji: '🌉' },
      { name: 'Pantai Teluk Ketapang', time: '4.5 km', emoji: '🏖️' },
      { name: 'Pantai Batu Buruk', time: '12 km', emoji: '🏖️' },
      { name: 'Pasar Payang', time: '11 km', emoji: '🛍️' },
      { name: 'Stadium Gong Badak', time: '1.5 km', emoji: '🏟️' },
      { name: 'KTCC / Mayang Mall', time: '11 km', emoji: '🛒' },
      { name: 'Airport', time: '2.5 km', emoji: '✈️' },
    ],
  },
];
---

<section id="location" class="section-padding bg-cream" aria-label="Location">
  <div class="container-custom">
    <div class="text-center mb-12">
      <p class="section-eyebrow">Location</p>
      <h2 class="section-title">Our Locations</h2>
      <p class="section-subtitle">
        Two convenient locations in Terengganu, each close to popular attractions and amenities.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      {homestays.map((hs) => (
        <div class="space-y-6">
          <h3 class="text-xl font-display font-semibold text-black flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            {hs.name}
          </h3>

          <!-- Map -->
          <div class="overflow-hidden shadow-soft h-[250px] border border-gray-100">
            <iframe
              src={`https://www.google.com/maps?q=${hs.coords}&output=embed&z=17`}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Google Maps location of ${hs.name}`}
              aria-label={`Map showing ${hs.name}`}
            ></iframe>
          </div>

          <!-- Address & Nearby -->
          <div class="card bg-white border border-gray-100 p-6">
            <div class="flex items-start gap-3 mb-4">
              <div class="w-10 h-10 bg-primary/10 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-600">{hs.address}</p>
                <a
                  href={hs.mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-primary hover:text-primary-700 text-sm font-bold uppercase tracking-wide mt-1 transition-colors"
                  aria-label={`Open ${hs.name} in Google Maps`}
                >
                  Open in Google Maps
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                </a>
              </div>
            </div>

            <h4 class="font-display font-semibold text-black mb-3 text-sm">Nearby Attractions</h4>
            <div class="space-y-2">
              {hs.nearbyPlaces.map((place) => (
                <div class="flex items-center justify-between p-2.5 border border-gray-100 hover:border-primary/40 hover:bg-primary/5 transition-colors group" itemscope itemtype="https://schema.org/Place">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-primary/10 flex items-center justify-center group-hover:scale-110 transition-transform flex-shrink-0">
                      <span aria-hidden="true" class="text-lg">{place.emoji}</span>
                    </div>
                    <span class="text-sm font-medium text-gray-700" itemprop="name">{place.name}</span>
                  </div>
                  <span class="text-xs font-bold text-white bg-primary px-2.5 py-1 uppercase tracking-wide">{place.time}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
