---
import Icon from './Icon.astro';
// Hero background: one 1280w WebP, preloaded above the fold.
// Served as a plain <img> so the preload URL and the element URL match exactly.
const heroWebp = '/images/kuala-terengganu/exterior-hero.webp';
const heroWebp640 = '/images/kuala-terengganu/exterior-hero-640.webp';
const heroWebp1280 = '/images/kuala-terengganu/exterior-hero-1280.webp';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden" aria-label="Hero section">
  <div class="absolute inset-0">
    <img
      src={heroWebp}
      srcset={`${heroWebp640} 640w, ${heroWebp} 1024w, ${heroWebp1280} 1280w`}
      sizes="100vw"
      alt="Exterior of Homestay Kenangan Kuala Terengganu"
      width="1280"
      height="1707"
      class="w-full h-full object-cover"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-[rgba(10,10,10,0.3)]"></div>
  </div>

  <!-- Content -->
  <div class="container-custom relative z-10 text-center py-32">
    <h1 class="mx-auto animate-fade-in">
      <picture>
        <source
          srcset="/images/logo-640.webp 640w, /images/logo-1024.webp 1024w"
          sizes="(max-width: 640px) 90vw, (max-width: 1024px) 680px, 860px"
          type="image/webp"
        />
        <img
          src="/images/logo-1024.webp"
          alt="Homestay Kenangan"
          width="1200"
          height="350"
          class="w-full max-w-[560px] sm:max-w-[680px] lg:max-w-[860px] h-auto mx-auto"
          fetchpriority="high"
        />
      </picture>
    </h1>
    <p class="mt-8 text-xs sm:text-sm text-white uppercase tracking-[0.3em]">
      Kemaman &nbsp;·&nbsp; Kuala Terengganu, Terengganu
    </p>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <a href="#booking-search" aria-label="Scroll to booking search" class="text-white/60 hover:text-white transition-colors">
      <Icon name="arrow-down" size={28} strokeWidth={2} />
      <span class="sr-only">Scroll down</span>
    </a>
  </div>
</section>
