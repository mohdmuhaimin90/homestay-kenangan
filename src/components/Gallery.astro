---
import Icon from './Icon.astro';
import ImageSlider from './ImageSlider.astro';

// Source dimensions are declared so the browser reserves layout space (no CLS)
// and picks the right WebP variant. Values match the files in public/images.
const kemamanImages = [
  { src: '/images/kemaman/Living Hall.jpg', w: 960, h: 1280, alt: 'Living hall at Homestay Kenangan Kemaman', cat: 'Living Room' },
  { src: '/images/kemaman/Family Hall.jpg', w: 960, h: 1280, alt: 'Family hall at Homestay Kenangan Kemaman', cat: 'Family Hall' },
  { src: '/images/kemaman/Diining Area.jpg', w: 960, h: 1280, alt: 'Dining area at Homestay Kenangan Kemaman', cat: 'Dining' },
  { src: '/images/kemaman/Kitchen.jpg', w: 960, h: 1280, alt: 'Kitchen at Homestay Kenangan Kemaman', cat: 'Kitchen' },
  { src: '/images/kemaman/Room 1.jpg', w: 960, h: 1280, alt: 'Bedroom 1 at Homestay Kenangan Kemaman', cat: 'Bedroom' },
  { src: '/images/kemaman/Room 2.jpg', w: 960, h: 1280, alt: 'Bedroom 2 at Homestay Kenangan Kemaman', cat: 'Bedroom' },
  { src: '/images/kemaman/Room 3.jpg', w: 960, h: 1280, alt: 'Bedroom 3 at Homestay Kenangan Kemaman', cat: 'Bedroom' },
];

const ktImages = [
  { src: '/images/kuala-terengganu/living room 1.jpg', w: 1280, h: 960, alt: 'Living room 1 at Homestay Kenangan Kuala Terengganu', cat: 'Living Room' },
  { src: '/images/kuala-terengganu/living room 2.jpg', w: 960, h: 1280, alt: 'Living room 2 at Homestay Kenangan Kuala Terengganu', cat: 'Living Room' },
  { src: '/images/kuala-terengganu/Dining area.jpg', w: 1280, h: 960, alt: 'Dining area at Homestay Kenangan Kuala Terengganu', cat: 'Dining' },
  { src: '/images/kuala-terengganu/Kitchen.jpg', w: 1280, h: 960, alt: 'Kitchen at Homestay Kenangan Kuala Terengganu', cat: 'Kitchen' },
  { src: '/images/kuala-terengganu/bedroom 1.jpg', w: 960, h: 1280, alt: 'Bedroom 1 at Homestay Kenangan Kuala Terengganu', cat: 'Bedroom' },
  { src: '/images/kuala-terengganu/bedroom 2.jpg', w: 960, h: 1280, alt: 'Bedroom 2 at Homestay Kenangan Kuala Terengganu', cat: 'Bedroom' },
  { src: '/images/kuala-terengganu/bedroom 3.jpg', w: 960, h: 1280, alt: 'Bedroom 3 at Homestay Kenangan Kuala Terengganu', cat: 'Bedroom' },
  { src: '/images/kuala-terengganu/bedroom 4.jpg', w: 960, h: 1280, alt: 'Bedroom 4 at Homestay Kenangan Kuala Terengganu', cat: 'Bedroom' },
  { src: '/images/kuala-terengganu/Bathroom 1.jpg', w: 960, h: 1280, alt: 'Bathroom 1 at Homestay Kenangan Kuala Terengganu', cat: 'Bathroom' },
  { src: '/images/kuala-terengganu/bathroom 2.jpg', w: 750, h: 1000, alt: 'Bathroom 2 at Homestay Kenangan Kuala Terengganu', cat: 'Bathroom' },
  { src: '/images/kuala-terengganu/bathroom 3.jpg', w: 750, h: 1000, alt: 'Bathroom 3 at Homestay Kenangan Kuala Terengganu', cat: 'Bathroom' },
  { src: '/images/kuala-terengganu/bathroom 4.jpg', w: 750, h: 1000, alt: 'Bathroom 4 at Homestay Kenangan Kuala Terengganu', cat: 'Bathroom' },
  { src: '/images/kuala-terengganu/Outdoor BBQ.jpg', w: 750, h: 1000, alt: 'Outdoor BBQ area at Homestay Kenangan Kuala Terengganu', cat: 'Outdoor' },
  { src: '/images/kuala-terengganu/Outdoor playground.jpg', w: 750, h: 1000, alt: 'Outdoor playground at Homestay Kenangan Kuala Terengganu', cat: 'Outdoor' },
  { src: '/images/kuala-terengganu/Outdoor.jpg', w: 750, h: 1000, alt: 'Outdoor area at Homestay Kenangan Kuala Terengganu', cat: 'Outdoor' },
  { src: '/images/kuala-terengganu/exterior.jpg', w: 750, h: 1000, alt: 'Exterior of Homestay Kenangan Kuala Terengganu', cat: 'Exterior' },
];

const allImages = [
  { location: 'Kemaman', key: 'kemaman', images: kemamanImages },
  { location: 'Kuala Terengganu', key: 'kuala-terengganu', images: ktImages },
];
---

<section id="gallery" class="section-padding bg-cream" aria-label="Photo gallery">
  <div class="container-custom">
    <div class="text-center mb-12">
      <p class="section-eyebrow">Gallery</p>
      <h2 class="section-title">Our Homestay Gallery</h2>
      <p class="section-subtitle">
        Browse photos from both our locations in Kemaman and Kuala Terengganu. Swipe left or right to browse.
      </p>
    </div>

    {allImages.map(({ location, key, images }) => (
      <div class="mb-12 last:mb-0">
        <h3 class="text-2xl font-display font-semibold text-black mb-6 flex items-center gap-3">
          <Icon name="map" size={24} class="text-primary" strokeWidth={2} />
          {location}
        </h3>

        <ImageSlider location={location} sliderKey={key} images={images} />
      </div>
    ))}
  </div>
</section>
