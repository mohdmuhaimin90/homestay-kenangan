---
import Icon from './Icon.astro';
const WHATSAPP_NUMBER = '60199144505';
const WHATSAPP_MESSAGE = encodeURIComponent("Hi I'm interested in booking your homestay.");
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MESSAGE}`;
---

<!-- Floating WhatsApp Button -->
<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-[#800020] hover:bg-[#6E001B] text-white shadow-lg hover:shadow-xl flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 group"
  aria-label="Contact us on WhatsApp"
>
  <Icon name="phone" size={28} strokeWidth={2} />
  <span class="absolute right-full mr-3 bg-ink text-white text-xs font-medium px-3 py-1.5 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
    Chat with us
  </span>
</a>
