---
import Icon from './Icon.astro';
interface GalleryImage {
  src: string;
  alt: string;
  cat?: string;
  w?: number;
  h?: number;
}

interface Props {
  location: string;
  sliderKey?: string;
  images: GalleryImage[];
  slideClass?: string;
}

const { location, sliderKey, images, slideClass } = Astro.props;
// Keyed by the folder name so spaces in the label cannot break the id/anchor.
const id = sliderKey || location.toLowerCase().replace(/\s+/g, '-');
const sliderId = `slider-${id}`;
const lightboxId = `lightbox-${id}`;
const defaultSlideClass = 'w-[78vw] sm:w-[420px] md:w-[480px]';
const itemClass = slideClass || defaultSlideClass;
const total = images.length;
const imagesJson = JSON.stringify(images.map((img) => ({ src: img.src, alt: img.alt })));

// WebP sibling paths: "/a/b.jpg" -> "/a/b.webp", "/a/b-640.webp", "/a/b-1280.webp".
// Width descriptors let the browser pick the smallest file that stays sharp.
const webpAt = (src: string, w: number | 'full') =>
  src.replace(/\.(jpe?g|png)$/i, w === 'full' ? '.webp' : `-${w}.webp`);
const webpSrcset = (src: string) =>
  `${webpAt(src, 320)} 320w, ${webpAt(src, 640)} 640w, ${webpAt(src, 1024)} 1024w, ${webpAt(src, 1280)} 1280w`;
const toWebp = (src: string) => webpAt(src, 'full');
---

<div class="relative" data-slider={sliderId} data-slider-id={sliderId} data-lightbox-id={lightboxId} data-location={location} data-images={imagesJson}>
  <div
    id={sliderId}
    class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-hide pb-2"
    data-slider-track
    role="region"
    aria-label={`${location} photo slider`}
    aria-roledescription="carousel"
  >
    {images.map((img, i) => (
      <button
        type="button"
        data-open-lightbox={`${i}`}
        class={`${itemClass} snap-center shrink-0 group block relative overflow-hidden shadow-soft hover:shadow-hover transition-all duration-300 cursor-pointer text-left focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2`}
        aria-label={`View ${img.alt} (${i + 1} of ${total})`}
      >
        <picture>
          <source srcset={webpSrcset(img.src)} sizes="(max-width: 640px) 78vw, (max-width: 768px) 420px, 480px" type="image/webp" />
          <img
            src={toWebp(img.src)}
            alt={img.alt}
            width={img.w}
            height={img.h}
            class="w-full h-[220px] sm:h-[260px] object-cover group-hover:scale-105 transition-transform duration-500"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
          />
        </picture>
        {img.cat && (
          <span class="absolute top-3 left-3 px-3 py-1 bg-black/70 text-white text-xs font-medium uppercase tracking-wide backdrop-blur-sm">
            {img.cat}
          </span>
        )}
        <span class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
          <span class="w-10 h-10 bg-white/90 text-primary flex items-center justify-center">
            <Icon name="search" size={18} strokeWidth={2} />
          </span>
        </span>
      </button>
    ))}
  </div>

  <!-- Prev / Next Arrows -->
  <button
    type="button"
    data-slider-prev
    class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white border border-gray-200 text-primary shadow-lg flex items-center justify-center hover:bg-primary hover:text-white hover:border-primary transition-all focus:outline-none focus:ring-2 focus:ring-primary"
    aria-label={`Previous ${location} photo`}
  >
    <Icon name="chevron-left" size={20} strokeWidth={2} />
  </button>
  <button
    type="button"
    data-slider-next
    class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white border border-gray-200 text-primary shadow-lg flex items-center justify-center hover:bg-primary hover:text-white hover:border-primary transition-all focus:outline-none focus:ring-2 focus:ring-primary"
    aria-label={`Next ${location} photo`}
  >
    <Icon name="chevron-right" size={20} strokeWidth={2} />
  </button>
</div>

<!-- Lightbox -->
<div
  id={lightboxId}
  class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/95"
  role="dialog"
  aria-modal="true"
  aria-label={`${location} photo lightbox`}
  data-lightbox
>
  <button
    type="button"
    data-lightbox-close
    class="absolute top-4 right-4 z-[72] text-white/80 hover:text-white bg-black/40 hover:bg-black/60 p-2.5 transition-colors"
    aria-label="Close lightbox"
  >
    <Icon name="x" size={24} strokeWidth={2} />
  </button>

  <button
    type="button"
    data-lightbox-prev
    class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-[72] w-11 h-11 md:w-12 md:h-12 bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-white"
    aria-label="Previous photo"
  >
    <Icon name="chevron-left" size={24} strokeWidth={2} />
  </button>

  <button
    type="button"
    data-lightbox-next
    class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-[72] w-11 h-11 md:w-12 md:h-12 bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-white"
    aria-label="Next photo"
  >
    <Icon name="chevron-right" size={24} strokeWidth={2} />
  </button>

  <div class="relative z-[71] w-full h-full flex flex-col items-center justify-center px-14 md:px-20" data-lightbox-stage>
    <picture>
      <source srcset="" type="image/webp" data-lightbox-source />
      <img
        src=""
        alt=""
        class="max-h-[80vh] max-w-full w-auto shadow-2xl select-none"
        draggable="false"
        data-lightbox-image
        style="touch-action: pan-y;"
      />
    </picture>
    <p class="text-white/70 text-center mt-5 text-sm" data-lightbox-caption></p>
    <p class="text-white/40 text-center mt-2 text-xs" data-lightbox-counter></p>
  </div>
</div>


