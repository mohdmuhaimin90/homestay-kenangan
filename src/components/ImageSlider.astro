---
interface GalleryImage {
  src: string;
  alt: string;
  cat?: string;
}

interface Props {
  location: string;
  images: GalleryImage[];
  slideClass?: string;
}

const { location, images, slideClass } = Astro.props;
const id = location.toLowerCase().replace(/\s+/g, '-');
const sliderId = `slider-${id}`;
const lightboxId = `lightbox-${id}`;
const defaultSlideClass = 'w-[78vw] sm:w-[420px] md:w-[480px]';
const itemClass = slideClass || defaultSlideClass;
const total = images.length;
const sliderIdJson = JSON.stringify(sliderId);
const lightboxIdJson = JSON.stringify(lightboxId);
const locationJson = JSON.stringify(location);
const imagesJson = JSON.stringify(images.map((img) => ({ src: img.src, alt: img.alt })));
---

<div class="relative" data-slider={sliderId} data-slider-id={sliderId} data-lightbox-id={lightboxId} data-location={location} data-images={imagesJson}>
  <div
    id={sliderId}
    class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-hide pb-2"
    data-slider-track
    role="region"
    aria-label={`${location} photo slider`}
    aria-roledescription="carousel"
  >
    {images.map((img, i) => (
      <button
        type="button"
        data-open-lightbox={`${i}`}
        class={`${itemClass} snap-center shrink-0 group block relative rounded-2xl overflow-hidden shadow-soft hover:shadow-hover transition-all duration-300 cursor-pointer text-left focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2`}
        aria-label={`View ${img.alt} (${i + 1} of ${total})`}
      >
        <img
          src={img.src}
          alt={img.alt}
          class="w-full h-[220px] sm:h-[260px] object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
        {img.cat && (
          <span class="absolute top-3 left-3 px-3 py-1 bg-black/70 text-white text-xs font-medium rounded-full backdrop-blur-sm">
            {img.cat}
          </span>
        )}
        <span class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
          <span class="w-10 h-10 rounded-full bg-white/90 text-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </span>
        </span>
      </button>
    ))}
  </div>

  <!-- Prev / Next Arrows -->
  <button
    type="button"
    data-slider-prev
    class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-primary rounded-full shadow-lg flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-700 hover:scale-110 transition-all focus:outline-none focus:ring-2 focus:ring-primary"
    aria-label={`Previous ${location} photo`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>
  <button
    type="button"
    data-slider-next
    class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-primary rounded-full shadow-lg flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-700 hover:scale-110 transition-all focus:outline-none focus:ring-2 focus:ring-primary"
    aria-label={`Next ${location} photo`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>
</div>

<!-- Lightbox -->
<div
  id={lightboxId}
  class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/95"
  role="dialog"
  aria-modal="true"
  aria-label={`${location} photo lightbox`}
  data-lightbox
>
  <button
    type="button"
    data-lightbox-close
    class="absolute top-4 right-4 z-[72] text-white/80 hover:text-white bg-black/40 hover:bg-black/60 rounded-full p-2.5 transition-colors"
    aria-label="Close lightbox"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <button
    type="button"
    data-lightbox-prev
    class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-[72] w-11 h-11 md:w-12 md:h-12 bg-white/10 hover:bg-white/25 text-white rounded-full flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-white"
    aria-label="Previous photo"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>

  <button
    type="button"
    data-lightbox-next
    class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-[72] w-11 h-11 md:w-12 md:h-12 bg-white/10 hover:bg-white/25 text-white rounded-full flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-white"
    aria-label="Next photo"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>

  <div class="relative z-[71] w-full h-full flex flex-col items-center justify-center px-14 md:px-20" data-lightbox-stage>
    <img
      src=""
      alt=""
      class="max-h-[80vh] max-w-full w-auto rounded-2xl shadow-2xl select-none"
      draggable="false"
      data-lightbox-image
      style="touch-action: pan-y;"
    />
    <p class="text-white/70 text-center mt-5 text-sm" data-lightbox-caption></p>
    <p class="text-white/40 text-center mt-2 text-xs" data-lightbox-counter></p>
  </div>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-slider-id]').forEach((sliderEl) => {
      const sliderId = sliderEl.dataset.sliderId;
      const location = sliderEl.dataset.location;
      const images = JSON.parse(sliderEl.dataset.images || '[]');

      const track = sliderEl.querySelector('[data-slider-track]');
      const prevBtn = sliderEl.querySelector('[data-slider-prev]');
      const nextBtn = sliderEl.querySelector('[data-slider-next]');

      const lightboxId = sliderEl.dataset.lightboxId;
      const lightbox = document.getElementById(lightboxId);
      const lbImage = lightbox.querySelector('[data-lightbox-image]');
      const lbCaption = lightbox.querySelector('[data-lightbox-caption]');
      const lbCounter = lightbox.querySelector('[data-lightbox-counter]');
      const lbPrev = lightbox.querySelector('[data-lightbox-prev]');
      const lbNext = lightbox.querySelector('[data-lightbox-next]');
      const lbClose = lightbox.querySelector('[data-lightbox-close]');

      const slides = Array.from(track.querySelectorAll('[data-open-lightbox]'));
      let current = 0;

      function scrollByCard(dir) {
        const item = track.querySelector('[data-open-lightbox]');
        const width = item ? item.getBoundingClientRect().width + 16 : 420;
        track.scrollBy({ left: dir * width, behavior: 'smooth' });
      }

      prevBtn.addEventListener('click', () => scrollByCard(-1));
      nextBtn.addEventListener('click', () => scrollByCard(1));

      function renderSlide() {
        if (!lbImage || !images[current]) return;
        lbImage.src = images[current].src;
        lbImage.alt = images[current].alt;
        if (lbCaption) lbCaption.textContent = images[current].alt;
        if (lbCounter) lbCounter.textContent = (current + 1) + ' / ' + images.length;
      }

      function openLightbox(index) {
        current = index;
        renderSlide();
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }

      slides.forEach((slide, i) => {
        slide.addEventListener('click', () => {
          const idx = parseInt(slide.getAttribute('data-open-lightbox'), 10) || i;
          openLightbox(idx);
        });
      });

      lbClose.addEventListener('click', closeLightbox);

      function go(delta) {
        current = (current + delta + images.length) % images.length;
        renderSlide();
      }

      lbPrev.addEventListener('click', (e) => { e.stopPropagation(); go(-1); });
      lbNext.addEventListener('click', (e) => { e.stopPropagation(); go(1); });

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') go(-1);
        if (e.key === 'ArrowRight') go(1);
      });

      let touchStartX = 0;
      let touchStartY = 0;
      lbImage.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }, { passive: true });
      lbImage.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) go(1);
          else go(-1);
        }
      }, { passive: true });
    });
  })();
</script>