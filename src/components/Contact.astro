---
const WHATSAPP_NUMBER = '60199144505';
const WHATSAPP_MESSAGE = encodeURIComponent("Hi I'm interested in booking your homestay.");
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MESSAGE}`;
const PHONE_NUMBER = '+60 19-914 4505';
const EMAIL = 'kenangan.homestay@gmail.com';
---

<div id="contact" class="bg-primary p-8 md:p-10 text-center" aria-label="Contact us">
  <div class="relative z-10">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-lg text-white/80 mb-2">Contact Us</p>
      <h2 class="font-display text-3xl md:text-4xl lg:text-[44px] font-semibold text-white mb-4">
        Ready to Stay With Us?
      </h2>
      <p class="text-lg text-white/80 max-w-2xl mx-auto mb-8 leading-relaxed">
        Book your stay directly through WhatsApp for the best rates and instant confirmation.
        Choose from our two locations in Kemaman or Kuala Terengganu.
      </p>

      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 h-[46px] px-8 bg-[#25D366] text-white text-[13px] font-bold uppercase tracking-wide transition-colors duration-300 hover:bg-[#1EBE5A]"
        aria-label="Book now via WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Book Now!
      </a>

      <div class="grid sm:grid-cols-3 gap-4 mt-12">
        <div class="border border-white/25 p-5">
          <div class="w-10 h-10 bg-white/15 flex items-center justify-center mx-auto mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <p class="text-white font-medium text-sm">{PHONE_NUMBER}</p>
        </div>
        <div class="border border-white/25 p-5">
          <div class="w-10 h-10 bg-white/15 flex items-center justify-center mx-auto mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <p class="text-white font-medium text-sm">{EMAIL}</p>
        </div>
        <div class="border border-white/25 p-5">
          <div class="w-10 h-10 bg-white/15 flex items-center justify-center mx-auto mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <p class="text-white font-medium text-sm">Kemaman & Kuala Terengganu</p>
        </div>
      </div>
    </div>
  </div>
</div>
