---
import Icon from './Icon.astro';
const highlights = [
  'Spacious Rooms',
  'Clean Environment',
  'Family Friendly',
  'Affordable Price',
  'Strategic Location',
  'Self Check-in',
  'Free Parking',
];

const homestays = [
  {
    name: 'Homestay Kenangan Kemaman',
    description: 'A cozy homestay located in the heart of Kemaman, Terengganu. Features 3 bedrooms, 1 bathroom, and 1 toilet. Perfect for families.',
    image: '/images/kemaman/Living Hall.jpg',
    imageWebp: '/images/kemaman/Living Hall.webp',
    w: 960,
    h: 1280,
    mapUrl: 'https://maps.app.goo.gl/KyBmg1iwgqLiSsha9',
  },
  {
    name: 'Homestay Kenangan Kuala Terengganu',
    description: 'A spacious homestay in Kuala Terengganu with 4 bedrooms and 4 bathrooms. Close to local attractions, restaurants, and beaches. Ideal for large families and groups.',
    image: '/images/kuala-terengganu/living room 1.jpg',
    imageWebp: '/images/kuala-terengganu/living room 1.webp',
    w: 1280,
    h: 960,
    mapUrl: 'https://maps.app.goo.gl/SCBDByiRjyYQefny6',
  },
];
---

<section id="about" class="section-padding bg-white" aria-label="About us">
  <div class="container-custom">
    <div class="text-center mb-12">
      <p class="section-eyebrow">About Us</p>
      <h2 class="section-title">Why Choose Homestay Kenangan</h2>
      <p class="section-subtitle">
        We provide comfortable and memorable stays for families and travelers at two convenient locations in Terengganu.
      </p>
    </div>

    <!-- Two Homestays -->
    <div class="grid md:grid-cols-2 gap-8 mb-16">
      {homestays.map((hs) => (
        <div class="card group border border-gray-100 hover:border-primary/40 hover:-translate-y-1 overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden">
            <picture>
              <source srcset={`${hs.imageWebp.replace(/\.webp$/, "-640.webp")} 640w, ${hs.imageWebp} 1024w, ${hs.imageWebp.replace(/\.webp$/, "-1280.webp")} 1280w`} sizes="(max-width: 768px) 100vw, 50vw" type="image/webp" />
              <img
                src={hs.image}
                alt={hs.name}
                width={hs.w}
                height={hs.h}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <div class="p-6">
            <h3 class="font-display text-xl font-semibold text-black mb-2">{hs.name}</h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{hs.description}</p>
            <a
              href={hs.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-primary hover:text-primary-700 text-sm font-bold uppercase tracking-wide transition-colors"
              aria-label={`View ${hs.name} on Google Maps`}
            >
              <Icon name="map" size={16} strokeWidth={2} />
              View Location
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Highlights -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {highlights.map((item) => (
        <div class="flex items-center gap-3 p-4 border border-gray-100 hover:border-primary/40 transition-colors group">
          <div class="w-10 h-10 bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors flex-shrink-0">
            <Icon name="check" size={18} strokeWidth={2} />
          </div>
          <span class="text-sm font-medium text-gray-700">{item}</span>
        </div>
      ))}
    </div>
  </div>
</section>
