---
import Icon from './Icon.astro';
const WHATSAPP_NUMBER = '60199144505';
const WHATSAPP_MESSAGE = encodeURIComponent("Hi I'm interested in booking your homestay.");
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MESSAGE}`;
const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/facilities', label: 'Facilities' },
  { href: '/#location', label: 'Location' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="bg-cream text-gray-700" aria-label="Site footer">
  <div class="container-custom py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="space-y-4">
        <a href="/" class="inline-block" aria-label="Homestay Kenangan - Home">
          <img
            src="/images/logo-dark-640.webp"
            alt="Homestay Kenangan"
            width="1200"
            height="350"
            class="w-auto max-w-[170px] h-[50px]"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-sm text-gray-600 leading-relaxed">
          Clean, comfortable, and affordable homestays in Kemaman and Kuala Terengganu. Perfect for families and travelers.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-display text-black font-semibold mb-4">Quick Links</h3>
        <ul class="space-y-2.5">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-gray-600 hover:text-primary transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-display text-black font-semibold mb-4">Contact</h3>
        <ul class="space-y-2.5">
          <li>
            <a
              href={WHATSAPP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-gray-600 hover:text-primary transition-colors flex items-center gap-2"
              aria-label="Contact via WhatsApp"
            >
              <Icon name="phone" size={14} strokeWidth={2} />
              +60 19-914 4505
            </a>
          </li>
          <li>
            <a
              href="mailto:kenangan.homestay@gmail.com"
              class="text-sm text-gray-600 hover:text-primary transition-colors flex items-center gap-2"
            >
              <Icon name="mail" size={14} strokeWidth={2} />
              kenangan.homestay@gmail.com
            </a>
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <Icon name="map" size={14} strokeWidth={2} />
            Kemaman & Kuala Terengganu
          </li>
        </ul>
      </div>

      <!-- Map -->
      <div>
        <h3 class="font-display text-black font-semibold mb-4">Find Us</h3>
        <div class="space-y-2">
          <a
            href="https://maps.app.goo.gl/KyBmg1iwgqLiSsha9"
            target="_blank"
            rel="noopener noreferrer"
            class="block text-sm text-gray-600 hover:text-primary transition-colors"
            aria-label="Open Kemaman location in Google Maps"
          >
            Homestay Kenangan Kemaman
          </a>
          <a
            href="https://maps.app.goo.gl/SCBDByiRjyYQefny6"
            target="_blank"
            rel="noopener noreferrer"
            class="block text-sm text-gray-600 hover:text-primary transition-colors"
            aria-label="Open Kuala Terengganu location in Google Maps"
          >
            Homestay Kenangan Kuala Terengganu
          </a>
        </div>
        <div class="mt-4 overflow-hidden">
          <div class="aspect-[4/3] bg-white border border-gray-200 flex items-center justify-center">
            <Icon name="map" size={32} class="text-gray-400" strokeWidth={1.5} />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-200">
    <div class="container-custom py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-gray-600">
        &copy; {currentYear} Homestay Kenangan. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a
          href="/sitemap-index.xml"
          class="text-xs text-gray-600 hover:text-primary transition-colors"
        >
          Sitemap
        </a>
        <a
          href="/robots.txt"
          class="text-xs text-gray-600 hover:text-primary transition-colors"
        >
          Robots.txt
        </a>
      </div>
    </div>
  </div>
</footer>
