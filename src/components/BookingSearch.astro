---
const WHATSAPP_NUMBER = '60199144505';
const WHATSAPP_MESSAGE = encodeURIComponent("Hi I'm interested in booking your homestay.");
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MESSAGE}`;
---

<section id="booking-search" class="py-14 md:py-16 bg-white border-b border-gray-100">
  <div class="container-custom text-center">
    <p class="section-eyebrow">Plan Your Stay</p>
    <h2 class="section-title !mb-8">Book Now!</h2>

    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-3 h-[56px] px-8 bg-primary border-2 border-primary-700 text-white font-display text-lg md:text-xl uppercase tracking-wide hover:bg-primary-700 transition-colors"
      aria-label="Contact us now for booking via WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      Contact Us Now For Booking
    </a>

    <p class="text-center text-sm text-gray-500 mt-5">
      We will confirm availability instantly on WhatsApp.
    </p>
  </div>
</section>
