---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BookingSearch from '../components/BookingSearch.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import Facilities from '../components/Facilities.astro';
import Location from '../components/Location.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout
  title="Home"
  description="Homestay Kenangan - Clean, comfortable and affordable family homestays in Kemaman and Kuala Terengganu. Book via WhatsApp for the best rates!"
  canonical="https://homestay-kenangan.vercel.app/"
  preloadImage="/images/logo-1024.webp"
  preloadSrcset="/images/logo-640.webp 640w, /images/logo-1024.webp 1024w"
  preloadSizes="(max-width: 640px) 90vw, (max-width: 1024px) 680px, 860px"
>
  <Header />
  <main>
    <Hero />
    <BookingSearch />
    <About />
    <Gallery />
    <Facilities />
    <Location />
    <section class="section-padding bg-primary">
      <div class="container-custom grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">
        <Faq />
        <Contact />
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
