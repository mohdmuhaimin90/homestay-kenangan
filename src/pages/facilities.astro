---

<Layout
  title="Facilities"
  description="Explore all facilities and amenities at Homestay Kenangan. WiFi, air conditioning, full kitchen, Smart TV, free parking, BBQ area, and more."
  canonical="https://homestay-kenangan.vercel.app/facilities"
  ogType="article"
>
  <Header />
  <main>
    <!-- Page Header -->
    <section class="pt-32 pb-16 bg-forest text-white">
      <div class="container-custom text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold mb-4">Our Facilities</h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto">
          We provide everything you need for a comfortable and memorable stay.
        </p>
      </div>
    </section>

    <!-- Facilities Grid -->
    <section class="section-padding bg-white dark:bg-gray-900" aria-label="Facilities list">
      <div class="container-custom">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-4">
          {facilities.map((facility) => (
            <div class="card border border-gray-100 py-5 px-3 flex flex-col items-center text-center group hover:-translate-y-1 hover:border-primary/40 transition-all">
              <span class="text-2xl leading-none mb-2" aria-hidden="true">{facility.emoji}</span>
              <h3 class="font-display text-sm font-semibold text-black">
                {facility.title}
              </h3>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding bg-primary">
      <div class="container-custom text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Enjoy All These Amenities
        </h2>
        <p class="text-lg text-white/80 max-w-xl mx-auto mb-8">
          Book your stay and enjoy access to all facilities.
        </p>
        <a
          href="https://wa.me/60199144505?text=Hi%20I'm%20interested%20in%20booking%20your%20homestay."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 h-[46px] px-8 bg-white text-primary text-[13px] font-bold uppercase tracking-wide hover:bg-black hover:text-white transition-colors"
          aria-label="Book now via WhatsApp"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          Book via WhatsApp
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
